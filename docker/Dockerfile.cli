# OxiGeo CLI Docker Image
# Provides oxigeo command-line tool for geospatial operations
# Author: COOLJAPAN OU (Team Kitasan)

# Build stage
FROM rust:1.89-slim-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# Build CLI in release mode with optimizations
RUN cargo build --release --bin oxigeo \
    && strip target/release/oxigeo

# Runtime stage - minimal image
FROM debian:bookworm-slim

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 -s /bin/bash oxigeo

# Copy binary from builder
COPY --from=builder /build/target/release/oxigeo /usr/local/bin/oxigeo

# Create data directory
RUN mkdir -p /data && chown oxigeo:oxigeo /data

# Switch to non-root user
USER oxigeo
WORKDIR /data

# Set environment
ENV RUST_LOG=info \
    RUST_BACKTRACE=1 \
    PATH=/usr/local/bin:$PATH

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD oxigeo --version || exit 1

# Default command shows help
ENTRYPOINT ["oxigeo"]
CMD ["--help"]

# Build-time version, defaulting to the last released version; see docker/build.sh.
ARG OXIGEO_VERSION=0.2.0

LABEL org.opencontainers.image.title="OxiGeo CLI" \
      org.opencontainers.image.description="Command-line interface for OxiGeo geospatial operations" \
      org.opencontainers.image.vendor="COOLJAPAN OU (Team Kitasan)" \
      org.opencontainers.image.source="https://github.com/cool-japan/oxigeo" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${OXIGEO_VERSION}"
